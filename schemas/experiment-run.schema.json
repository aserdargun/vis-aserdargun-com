{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vis.aserdargun.com/schemas/experiment-run.schema.json",
  "title": "VIS experiment result",
  "description": "One measured experiment on one synthetic scene. Every numeric field is a measurement against the answer key produced alongside the scene; none is a self-assessment.",
  "type": "object",
  "required": [
    "schemaVersion",
    "experimentId",
    "sceneSeed",
    "engineId",
    "engineDescribe",
    "stage",
    "truth",
    "iou",
    "accuracy",
    "mae",
    "perClass",
    "extra",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "experimentId": {
      "type": "string",
      "enum": ["ground-truth", "edges", "regions", "lines", "learned", "depth", "motion", "domain-gap"]
    },
    "sceneSeed": { "type": "integer", "minimum": 1 },
    "engineId": { "type": "string", "enum": ["cpu", "webgpu"] },
    "engineDescribe": { "type": "string", "minLength": 1 },
    "stage": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "mask": { "$ref": "#/$defs/tensor" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "stage2": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "mask": { "$ref": "#/$defs/tensor" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "truth": { "$ref": "#/$defs/tensor" },
    "iou": { "type": "number", "minimum": 0, "maximum": 1 },
    "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "mae": { "type": "number", "minimum": 0, "maximum": 1 },
    "edgeRecall": { "type": "number", "minimum": 0, "maximum": 1 },
    "detection": {
      "type": "object",
      "required": ["predicted", "truth", "matched", "precision", "recall"],
      "properties": {
        "predicted": { "type": "integer", "minimum": 0 },
        "truth": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "meanIou": { "type": "number", "minimum": 0, "maximum": 1 },
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 }
      }
    },
    "perClass": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "iou", "pixels"],
        "properties": {
          "label": { "type": "integer", "minimum": 1 },
          "iou": { "type": "number", "minimum": 0, "maximum": 1 },
          "pixels": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": { "type": ["number", "string"] }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "required": ["w", "h", "data"],
      "properties": {
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 },
        "data": { "type": "array", "items": { "type": "number" } }
      }
    }
  }
}
